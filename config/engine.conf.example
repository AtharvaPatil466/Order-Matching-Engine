# Order Matching Engine — Example Configuration
#
# Copy to /etc/orderengine/engine.conf and pass it with --config PATH (or
# OB_CONFIG_PATH). An OB_<KEY> env var overrides a key only where code reads
# that key (e.g. "log_sink" → OB_LOG_SINK).
#
# MANY KEYS BELOW ARE READ BY NOTHING. They are marked "not read". Setting one
# changes nothing: no risk limit, rate limit, checkpoint threshold, port or
# replication timing is taken from this file. What is read: log_sink, the
# alert_* keys, order_pool_capacity / trade_history_capacity, and, on SIGHUP
# only, rate_limit.default_rate / rate_limit.default_burst. journal_path,
# instruments and participants are validated at startup but not applied.

# ── Core Engine ──────────────────────────────────────────────────────────────
# not read: use --threads / --symbols; lean mode is a build option (./build.sh --lean)
threads         = 4
symbols         = 4
lean_mode       = false

# ── Per-symbol memory ────────────────────────────────────────────────────────
# Both are allocated AND touched when a book is created, so they are resident
# per symbol whether or not an order ever arrives. Measured empty, 10 books:
# 10,000 slots = 10.3 MiB/book; 100,000 = 32.8 MiB; 200,000 = 57.9 MiB.
# Budget: symbols x MiB-per-book must fit in RAM before anything trades.
#
# order_pool_capacity is the max number of LIVE orders a symbol can hold
# (192 B each). The book warns at 80% utilization and sheds new orders at 95%,
# so size it above the symbol's peak resting-order count, not at it. The
# order-id lookup map is sized from this value automatically — it has no key of
# its own, so it can never be configured smaller than the pool it indexes.
#
# These two are read from the file named by OB_CONFIG_PATH (or from
# OB_ORDER_POOL_CAPACITY / OB_TRADE_HISTORY_CAPACITY), not from --config alone
# (src/OrderBook.cpp sizingConfig).
order_pool_capacity    = 10000
# Trades retained in the in-memory ring (80 B each). Rounded up to a power of
# two. Only affects getTradeHistory(); the journal/market-data feeds are
# unaffected.
trade_history_capacity = 65536

# ── Networking ───────────────────────────────────────────────────────────────
# not read: OrderEngine's admin port is --port; GatewayServer's order port is an
# optional leading positional argument (default 9876)
admin_port      = 8080
gateway_port    = 9001

# ── Journaling ───────────────────────────────────────────────────────────────
# journal_path is only validated; the journal opened is --journal / OB_JOURNAL_PATH.
# checkpoint_* are not read: auto-checkpoint is fixed at 250,000 entries or
# 64 MiB, plus --journal-max-mb.
journal_path    = /var/lib/orderengine/journal.wal
checkpoint_entries = 100000
checkpoint_bytes   = 104857600

# ── Rate Limiting ────────────────────────────────────────────────────────────
# not read. The rate limiter is off unless a SIGHUP reload finds
# rate_limit.default_rate (and rate_limit.default_burst) in this file.
rate_limit_msgs_per_sec = 10000
rate_limit_burst        = 100
queue_depth_threshold   = 0.8

# ── Risk Limits ──────────────────────────────────────────────────────────────
# not read: neither binary applies any risk limit from configuration
max_order_size   = 1000000
max_notional     = 100000000
max_position     = 5000000
otr_threshold    = 100

# ── Circuit Breakers ─────────────────────────────────────────────────────────
# not read: the breaker is fixed at 5% and nothing resumes a tripped book;
# the price band stays off
price_band_pct   = 0.05
halt_duration_ms = 30000

# ── High Availability ────────────────────────────────────────────────────────
# not read: replication uses --role / OB_NODE_ROLE (plus
# --allow-unsafe-replication) and OB_* env vars, with compiled-in timings
# (heartbeat 100 ms, timeout 500 ms, lease 5000 ms)
node_id           = 1
node_role         = primary
replication_port  = 9002
# Backup settings (ignored when node_role=primary):
# primary_host    = 10.0.0.1
# primary_replication_port = 9002
heartbeat_interval_ms = 100
heartbeat_timeout_ms  = 500
lease_duration_ms     = 5000

# ── Alerting ─────────────────────────────────────────────────────────────────
#
# THE ENGINE HAS NO TLS CLIENT, SO THE URL MUST BE http://, NOT https://.
#
# AlertDispatcher speaks plain HTTP. An https:// URL is refused AT STARTUP and
# the engine will not boot — deliberately, because the alternative is alerting
# that silently drops every alert and an operator who discovers it during the
# incident it was supposed to announce. The example below used to read
# https://hooks.slack.com/... , which this code has never been able to deliver.
#
# This is not an oversight waiting on a patch. The engine has no external
# dependencies beyond liburing on Linux, and linking OpenSSL to deliver one
# webhook would trade that for a supply-chain surface on the alerting path.
# Terminate TLS outside the process:
#
#   engine --http--> 127.0.0.1 sidecar --https--> Slack / PagerDuty
#
# Any local forwarder does this. For example, with a one-line nginx or a
# 20-line reverse proxy listening on 8081 that holds the real Slack URL:
#
# alert_webhook_url    = http://127.0.0.1:8081/alerts
# alert_webhook_format = slack          # generic | slack | pagerduty
# alert_min_level      = warning        # info | warning | critical | fatal
# alert_routing_key    =                # PagerDuty Events API v2 routing key
#
# Keeping the real endpoint in the sidecar rather than this file also keeps a
# credential-bearing URL out of the engine's config.
#
# Leave alert_webhook_url unset to run without webhook alerting. Capacity and
# kill-switch events still reach the structured log sink (see log_sink below),
# which is where they go today.

# ── Logging ──────────────────────────────────────────────────────────────────
log_sink = stderr
# log_sink = null     (zero-cost, production default)
# log_sink = stderr   (JSON to stderr, dev/debugging)
